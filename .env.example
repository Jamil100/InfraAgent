# Azure AI Foundry
PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
MODEL_DEPLOYMENT_NAME=azureml://registries/azure-openai/models/gpt-5.4-mini/versions/2026-03-17

# Azure (for subscription discovery + deployments)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# GitHub (for PR workflow)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_TARGET_BRANCH=main

# MCP Servers (optional — leave blank to disable)
MCP_BICEP_URL=
MCP_TERRAFORM_URL=
MCP_AZURE_URL=

# Deployment (optional — set to enable deploy stage; if blank, pipeline stops at PR)
DEPLOY_RESOURCE_GROUP=
DEPLOY_LOCATION=eastus

# App
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
